style.
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
    background-color: #f0ede2;
    margin: 0;
    padding: 24px 0;
    font-size: 15px;
    line-height: 24px;
    color: #1c3d1e;
  }
  .container {
    max-width: 600px;
    margin: 0 auto;
    background-color: #fffdf5;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #d4c5a9;
  }
  .header-banner {
    background-color: #275129;
    padding: 36px 32px;
    text-align: center;
    color: #fffdf5;
  }
  .header-banner .brand {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #c5e1a5;
    margin-bottom: 8px;
  }
  .header-banner h1 {
    font-size: 28px;
    font-weight: 800;
    margin: 0;
    line-height: 1.2;
  }
  .content-wrapper {
    padding: 36px 32px;
  }
  .greeting {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .description {
    margin-bottom: 20px;
    color: #4a5d3a;
  }
  .description strong {
    color: #1c3d1e;
    margin: 0 4px;
  }
  .code-box {
    background-color: #f6faf9;
    border: 2px dashed #94b578;
    padding: 24px;
    border-radius: 12px;
    margin: 16px 0;
    text-align: center;
  }
  .code-label {
    font-size: 11px;
    color: #558b2f;
    font-weight: 800;
    margin-bottom: 10px;
    letter-spacing: 2px;
  }
  .code-value {
    font-size: 40px;
    font-weight: 800;
    color: #275129;
    letter-spacing: 10px;
    margin: 0;
  }
  .warning-box {
    background-color: #fff8e1;
    border-left: 4px solid #ffb300;
    padding: 14px 18px;
    border-radius: 8px;
    margin: 16px 0;
  }
  .warning-text {
    font-size: 14px;
    color: #7a5200;
    margin: 0;
  }
  .button-container {
    text-align: center;
    margin: 24px 0 8px;
  }
  .button {
    display: inline-block;
    background-color: #2e7d60;
    color: #ffffff !important;
    padding: 12px 40px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
  }
  .divider {
    border: 0;
    border-top: 1px solid #e5e0cf;
    margin: 28px 0;
    height: 0;
  }
  .footer-section {
    background-color: #f0ede2;
    padding: 20px 32px;
    text-align: center;
    font-size: 13px;
    color: #7a8a6a;
  }
  .footer-text {
    margin: 6px 0;
    line-height: 20px;
  }
  .footer-link {
    color: #2e7d60;
    text-decoration: none;
    font-weight: 700;
  }

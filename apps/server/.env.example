PORT=8080
NODE_ENV=development
APP_NAME=Gốm Sứ Xanh
# URL trang client (dùng cho link trong email)
CLIENT_URL=http://localhost:3000
# Các origin được phép gọi API (client, admin), cách nhau bởi dấu phẩy
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001

# Database — Supabase: Project Settings → Database → Connection string → "Session pooler"
# Ví dụ: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Mật khẩu có ký tự đặc biệt (@, #, /...) thì phải URL-encode
DATABASE_URL=
DATABASE_SSL=true

# JWT — mỗi secret tối thiểu 32 ký tự. Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
REFRESH_TOKEN_HASH_SECRET=
AUTH_TOKEN_HASH_SECRET=
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
MAX_SESSION_LIFETIME_IN=2592000

# OTP (xác thực email, quên mật khẩu)
OTP_EXPIRE_MINUTES=10

# Email — Gmail SMTP: SMTP_PASS là App Password (không phải mật khẩu Gmail)
# Ở môi trường development, để trống SMTP_USER thì mã OTP được in ra console thay vì gửi mail
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Swagger tại /docs
ENABLE_DOCS=true

# Tài khoản admin cho lệnh `pnpm seed:admin`
# Giá trị có ký tự # phải đặt trong ngoặc kép, vd: ADMIN_PASSWORD="mat-khau#cua-ban" — không có ngoặc thì phần từ # trở đi bị coi là comment
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Quản trị viên

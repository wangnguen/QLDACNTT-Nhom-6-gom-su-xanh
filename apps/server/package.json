{
  "name": "@gsx/server",
  "version": "1.0.0",
  "private": true,
  "description": "API server Gốm Sứ Xanh (Express 5 + TypeORM + PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "rimraf dist && tsc && tsc-alias && node -e \"require('fs').cpSync('src/assets', 'dist/assets', {recursive: true})\"",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typeorm": "node -r @swc-node/register ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm typeorm migration:generate -p -d src/databases/cli-data-source.ts",
    "migration:run": "pnpm typeorm migration:run -d src/databases/cli-data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/databases/cli-data-source.ts",
    "seed:admin": "node -r @swc-node/register src/databases/seeds/admin.seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pug": "^3.0.4",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "typeorm-naming-strategies": "^4.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.18",
    "@swc/helpers": "^0.5.19",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pug": "^2.0.10",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "5.0.5"
  }
}
